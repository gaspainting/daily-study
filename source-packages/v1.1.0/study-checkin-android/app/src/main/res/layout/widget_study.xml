<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="每日学习" android:textColor="#20201E" android:textSize="17sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_subjects" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="9dp" android:text="实际 / 参考" android:textColor="#20201E" android:textSize="13sp" android:maxLines="4" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="按状态慢慢来" android:textColor="#66655F" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_open" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:text="记录 →" android:paddingLeft="8dp" android:textColor="#20201E" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
